# =============================================================================
# ZirveTarım Front — ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın. `.env` ASLA commit edilmez.
#
# API bu depoda DEĞİL: https://github.com/EmreKaya2000/zirve-tarim-api
# Vitrinin çalışması için o API'nin ayakta olması gerekir.
# =============================================================================

# -----------------------------------------------------------------------------
# API ADRESLERİ
# -----------------------------------------------------------------------------

# TARAYICIDAN erişilebilen API adresi.
#
# NEXT_PUBLIC_ öneki zorunlu: değer istemci paketine gömülür. Dolayısıyla
# DERLEME ANINDA doğru olmalıdır — çalışma zamanında değiştirmek imajı
# yeniden derlemeyi gerektirir.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# SUNUCU TARAFI render sırasında kullanılan API adresi.
#
# Docker içinde servis adı üzerinden konuşulur: http://api:4000/api/v1
# Vitrin sayfalarının çoğu sunucu bileşeni olduğu için asıl veri bu adresten
# gelir. `/uploads` yönlendirmesinin hedefi de buradan türetilir ve o değer
# DERLEME ANINDA gömülür (next.config.ts açıklamasına bakın).
INTERNAL_API_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# SİTE KİMLİĞİ (SEO)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME=Zirve Tarım
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# ÇALIŞTIRMA
# -----------------------------------------------------------------------------

# Vitrinin portu. Yönetim paneli 3001 kullanır (ayrı depo, ayrı uygulama).
WEB_PORT=3000

# Playwright test sunucusunun portu. Geliştirme sunucusuyla çakışmasın diye
# ayrıdır. API'nin CORS_ORIGINS listesinde bu köken de bulunmalıdır.
E2E_WEB_PORT=3100

# Playwright'ın posta kutusunu okuduğu Mailpit adresi. Müşteri zinciri testi
# doğrulama bağlantısını GERÇEK e-postadan okur; verilmezse o test atlanır.
MAILPIT_URL=http://127.0.0.1:8025
